{
  "name": "family-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "test:imports": "tsx --test tests/import-parsers.test.ts",
    "test:balances": "tsx --test tests/account-balances.test.ts",
    "test:investments": "tsx --test tests/investment-presence.test.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "format": "prettier --write frontend backend docs tests README.md package.json wrangler.jsonc .prettierrc.json",
    "format:check": "prettier --check frontend backend docs tests README.md package.json wrangler.jsonc .prettierrc.json",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply family-finance --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-finance --remote"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
