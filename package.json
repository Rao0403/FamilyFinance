{
  "name": "family-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply family-finance --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-finance --remote"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0"
  }
}
